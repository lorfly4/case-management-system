<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Case Management System' %></title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    
    <!-- AdminLTE CSS v4 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc.7/dist/css/adminlte.min.css">
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="hold-transition <%= hideChrome ? 'register-page' : 'sidebar-mini layout-fixed' %>">
    <% if (!hideChrome) { %>
        <% const currentPath = typeof locals.currentPath !== 'undefined' ? locals.currentPath : ''; %>
        
        <div class="wrapper">
            <!-- Navbar -->
            <nav class="main-header navbar navbar-expand navbar-white navbar-light">
                <!-- Left navbar links -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                            <i class="fas fa-bars"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <a href="/dashboard" class="nav-link fw-bold">CMS Dashboard</a>
                    </li>
                </ul>

                <!-- Right navbar links -->
                <ul class="navbar-nav ms-auto">
                    <!-- User Account Dropdown -->
                    <% if (user) { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link" data-bs-toggle="dropdown" href="#">
                            <div class="user-panel d-flex">
                                <div class="image">
                                    <img src="https://www.gravatar.com/avatar/default?d=identicon&s=40" class="img-circle elevation-2" alt="User Image">
                                </div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <!-- User image row -->
                            <div class="user-panel d-block p-3">
                                <div class="d-flex">
                                    <div class="image">
                                        <img src="https://www.gravatar.com/avatar/default?d=identicon&s=60" class="img-circle elevation-2" alt="User Image">
                                    </div>
                                    <div class="info ms-3">
                                        <p class="mb-0 fw-bold"><%= user %></p>
                                        <p class="text-sm text-muted mb-0"><strong><%= role.toUpperCase() %></strong></p>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <!-- Logout -->
                            <a href="/logout" class="dropdown-item">
                                <i class="fas fa-sign-out-alt me-2"></i> Sign out
                            </a>
                        </div>
                    </li>
                    <% } %>
                </ul>
            </nav>

            <!-- Left side column. contains the sidebar -->
            <aside class="main-sidebar sidebar-dark-primary elevation-4">
                <a href="/dashboard" class="brand-link">
                    <img src="https://via.placeholder.com/40/007bff/ffffff?text=CMS" alt="CMS Logo" class="brand-image img-circle elevation-3">
                    <span class="brand-text font-weight-light fw-bold">CMS</span>
                </a>

                <!-- Sidebar -->
                <div class="sidebar">
                    <!-- Sidebar Menu -->
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                            <!-- Dashboard -->
                            <li class="nav-item">
                                <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
                                    <i class="nav-icon fas fa-th"></i>
                                    <p>Dashboard</p>
                                </a>
                            </li>

                            <!-- Cases Menu -->
                            <li class="nav-item <%= (currentPath === '/all-cases' || currentPath === '/case/new' || currentPath.includes('/cases/')) ? 'menu-open' : '' %>">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-copy"></i>
                                    <p>
                                        Cases
                                        <i class="fas fa-angle-left right"></i>
                                    </p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="/all-cases" class="nav-link <%= currentPath === '/all-cases' ? 'active' : '' %>">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>All Cases</p>
                                        </a>
                                    </li>
                                    <% if (role === 'admin' || role === 'spv') { %>
                                    <li class="nav-item">
                                        <a href="/case/new" class="nav-link <%= currentPath === '/case/new' ? 'active' : '' %>">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Create Case</p>
                                        </a>
                                    </li>
                                    <% } %>
                                </ul>
                            </li>

                            <!-- Management Menu (Admin/SPV only) -->
                            <% if (role === 'admin' || role === 'spv') { %>
                            <li class="nav-header">MANAGEMENT</li>
                            <li class="nav-item">
                                <a href="/import-cases" class="nav-link <%= currentPath === '/import-cases' ? 'active' : '' %>">
                                    <i class="nav-icon fas fa-file-upload"></i>
                                    <p>Import Cases</p>
                                </a>
                            </li>
                            <% } %>

                            <!-- Users Menu (Admin only) -->
                            <% if (role === 'admin') { %>
                            <li class="nav-item">
                                <a href="/users" class="nav-link <%= currentPath === '/users' ? 'active' : '' %>">
                                    <i class="nav-icon fas fa-users"></i>
                                    <p>Users</p>
                                </a>
                            </li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            </aside>

            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <!-- Content Header (Page header) -->
                <div class="content-header">
                    <div class="container-fluid">
                        <div class="row mb-2">
                            <div class="col-sm-6">
                                <h1 class="m-0"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h1>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main content -->
                <section class="content">
                    <div class="container-fluid">
    <% } else { %>
        <div class="">
    <% } %>