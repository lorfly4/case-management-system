    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- AdminLTE JS v4 -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc.7/dist/js/adminlte.min.js"></script>
    
    <!-- Chart JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Custom JS -->
    <script src="/js/custom.js"></script>
    
    <!-- Alert Helper Function & Initialization -->
    <script>
        function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            const section = document.querySelector('section.content');
            if (section) {
                section.insertAdjacentHTML('afterbegin', alertHtml);
            }
        }

        // Initialize when document is ready
        $(function() {
            // Initialize AdminLTE components
            if (typeof AdminLTE !== 'undefined') {
                AdminLTE.init();
            }

            // Setup sidebar treeview
            if ($.fn.dataTable) {
                // Tables already have DataTables
            }

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Setup active menu item based on current path
            const currentPath = window.location.pathname;
            $('.nav-link').each(function() {
                const href = $(this).attr('href');
                if (href === currentPath || (href && currentPath.includes(href.replace(/\/$/, '')))) {
                    $(this).addClass('active');
                    $(this).closest('.nav-item').addClass('menu-open');
                    $(this).parents('.nav-item').each(function() {
                        $(this).addClass('menu-open');
                        $(this).children('.nav-link').addClass('active');
                    });
                }
            });

            // Sidebar menu click handler for submenu toggle
            $('.nav-link').on('click', function(e) {
                const $navItem = $(this).parent();
                const $treeview = $navItem.find('.nav-treeview');
                
                if ($treeview.length) {
                    e.preventDefault();
                    $navItem.toggleClass('menu-open');
                }
            });

            // Push menu functionality
            $('[data-widget="pushmenu"]').on('click', function(e) {
                e.preventDefault();
                $('body').toggleClass('sidebar-collapse');
            });
        });
    </script>
</body>
</html>
