<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Case Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
            <div class="navbar-brand fw-bold ms-3">
                <i class="fas fa-briefcase"></i> CMS Dashboard
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header">
                            <strong><%= user %></strong> - <%= role.toUpperCase() %>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/dashboard" class="brand-link">
                <i class="fas fa-briefcase brand-image"></i>
                <span class="brand-text font-weight-light">CMS</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/dashboard" class="nav-link active">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Cases <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/all-cases" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Cases</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/case/new" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Create Case</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="/import-cases" class="nav-link">
                                <i class="nav-icon fas fa-file-upload"></i>
                                <p>Import Cases</p>
                            </a>
                        </li>
                        <% if (role === 'admin') { %>
                        <li class="nav-item">
                            <a href="/users" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">Dashboard</h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Alert for unassigned cases -->
                    <% if (typeof unassigned !== 'undefined' && unassigned > 0) { %>
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong><%= unassigned %></strong> cases waiting to be assigned!
                        <a href="/all-cases" class="btn btn-sm btn-warning ms-2">View Cases</a>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                    <!-- Category Summary -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5 class="mb-3">Case Distribution by Type</h5>
                        </div>
                        <% 
                        const categoryColors = {
                            'Regular Case': 'primary',
                            'On-Desk Case': 'success',
                            'Reliance Case': 'info'
                        };
                        const categoryIcons = {
                            'Regular Case': 'fa-file-alt',
                            'On-Desk Case': 'fa-desktop',
                            'Reliance Case': 'fa-shield-alt'
                        };
                        if (typeof categories !== 'undefined' && categories.length > 0) {
                            categories.forEach(cat => { %>
                                <div class="col-md-4 mb-3">
                                    <a href="/cases/<%= encodeURIComponent(cat.type) %>" class="text-decoration-none">
                                        <div class="card h-100 border-start border-4 border-<%= categoryColors[cat.type] || 'secondary' %>">
                                            <div class="card-body">
                                                <div class="row align-items-center">
                                                    <div class="col">
                                                        <h6 class="text-muted text-uppercase small fw-bold mb-1"><%= cat.type %></h6>
                                                        <h2 class="mb-0 fw-bold"><%= cat.count %></h2>
                                                    </div>
                                                    <div class="col-auto">
                                                        <i class="fas <%= categoryIcons[cat.type] || 'fa-folder' %> fa-2x text-<%= categoryColors[cat.type] || 'secondary' %> opacity-50"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                        <% });
                        } %>
                    </div>

                    <!-- Charts Row -->
                    <div class="row">
                        <!-- PIC Chart -->
                        <div class="col-md-7">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-chart-bar me-2 text-primary"></i>Top 5 PICs by Workload
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <% if (typeof topPIC !== 'undefined' && topPIC.length > 0) { %>
                                        <canvas id="picChart" height="100"></canvas>
                                    <% } else { %>
                                        <div class="alert alert-info text-center py-4">No PIC data available</div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Stats Table -->
                        <div class="col-md-5">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-list me-2 text-success"></i>Active Workload Detail
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <% if (typeof topPIC !== 'undefined' && topPIC.length > 0) { %>
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead>
                                                    <tr class="small text-muted text-uppercase">
                                                        <th class="ps-3">Rank</th>
                                                        <th>PIC Name</th>
                                                        <th class="text-center">Cases</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% topPIC.forEach((pic, index) => { %>
                                                    <tr>
                                                        <td class="ps-3">
                                                            <span class="badge badge-<%= index === 0 ? 'warning' : (index === 1 ? 'secondary' : 'light') %>">
                                                                <%= index + 1 %>
                                                            </span>
                                                        </td>
                                                        <td><strong><%= pic.username %></strong></td>
                                                        <td class="text-center">
                                                            <span class="badge badge-info"><%= pic.load_count %></span>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } else { %>
                                        <div class="alert alert-info text-center py-4">No workload data available</div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer text-center">
            <strong>Case Management System &copy; 2026</strong> - Built for Efficiency
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
    <script>
        $(function() {
            <% if (typeof topPIC !== 'undefined' && topPIC.length > 0) { %>
            const ctx = document.getElementById('picChart');
            if (ctx) {
                const picLabels = <%- JSON.stringify(topPIC.map(p => p.username)) %>;
                const picData = <%- JSON.stringify(topPIC.map(p => p.load_count)) %>;
                
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: picLabels,
                        datasets: [{
                            label: 'Active Cases',
                            data: picData,
                            backgroundColor: '#007bff',
                            borderColor: '#0056b3',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
            <% } %>
        });
    </script>
</body>
</html>