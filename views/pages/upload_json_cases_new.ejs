<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload JSON Cases - Deswa Management System</title>
        <link rel="icon" href="/images/logo.jpeg" type="image/jpeg">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .json-preview {
            background-color: #1e293b;
            color: #e2e8f0;
            padding: 16px;
            border-radius: 8px;
            max-height: 380px;
            overflow: auto;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.6;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .file-drop-zone {
            border: 2px dashed #94a3b8;
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            transition: all 0.3s;
            background-color: #f8fafc;
            cursor: pointer;
        }
        .file-drop-zone:hover, .file-drop-zone.active {
            border-color: #3b82f6;
            background-color: #eff6ff;
        }
        .file-drop-zone i.fa-cloud-upload-alt {
            font-size: 52px;
            color: #94a3b8;
            margin-bottom: 12px;
        }
        .case-type-badge {
            font-size: 13px;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }
        .type-hospital { background-color: #dbeafe; color: #1e40af; }
        .type-non-hospital { background-color: #fce7f3; color: #9d174d; }
        .status-badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .section-card {
            border-left: 4px solid #3b82f6;
        }
        .data-row {
            display: flex;
            padding: 8px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .data-row:last-child {
            border-bottom: none;
        }
        .data-label {
            width: 180px;
            flex-shrink: 0;
            font-weight: 600;
            color: #475569;
            font-size: 13px;
        }
        .data-value {
            flex: 1;
            color: #0f172a;
            font-size: 13px;
        }
        .mapping-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .mapping-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 0;
            font-size: 13px;
        }
        .old-label {
            background-color: rgba(255,255,255,0.2);
            padding: 3px 10px;
            border-radius: 15px;
            text-decoration: line-through;
            opacity: 0.9;
        }
        .arrow-icon { color: #fef08a; }
        .new-label {
            background-color: rgba(255,255,255,0.35);
            padding: 3px 10px;
            border-radius: 15px;
            font-weight: 700;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
            <div class="navbar-brand fw-bold ms-3">
                <i class="fas fa-file-code"></i> Upload 2 JSON Cases
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header">
                            <strong><%= user %></strong> - <%= role.toUpperCase() %>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/dashboard" class="brand-link">
                <img src="/images/logo.jpeg" alt="Deswa Management System logo" class="brand-image img-circle elevation-3">
                <span class="brand-text font-weight-light">Deswa Management System</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/dashboard" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Cases <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/all-cases" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Cases</p>
                                    </a>
                                </li>
                                <% if (role === 'admin' || role === 'spv') { %>
                                <li class="nav-item">
                                    <a href="/case/new" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Create Case</p>
                                    </a>
                                </li>
                                <% } %>
                            </ul>
                        </li>
                        <% if (role === 'admin' || role === 'spv') { %>
                        <li class="nav-item">
                            <a href="/import-cases" class="nav-link">
                                <i class="nav-icon fas fa-file-upload"></i>
                                <p>Import Cases (CSV)</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/upload-json-cases" class="nav-link active">
                                <i class="nav-icon fas fa-file-code"></i>
                                <p>Upload JSON Cases</p>
                            </a>
                        </li>
                        <% } %>
                        <% if (role === 'admin') { %>
                        <li class="nav-item">
                            <a href="/users" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">
                                <i class="fas fa-file-code me-2 text-primary"></i>
                                Upload 2 File JSON
                            </h1>
                        </div>
                        <div class="col-sm-6 text-end">
                            <a href="/all-cases" class="btn btn-secondary btn-sm">
                                <i class="fas fa-list me-1"></i>Lihat Semua Case
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <section class="content">
                <div class="container-fluid">

                    <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert <%= message.includes('Berhasil') || message.includes('Selesai') && !message.includes('Gagal') && !message.includes('kesalahan') && !message.includes('Error') && !message.includes('error') ? 'alert-success' : 'alert-danger' %> alert-dismissible fade show" role="alert">
                        <i class="fas <%= message.includes('Berhasil') ? 'fa-check-circle' : 'fa-exclamation-circle' %> me-2"></i>
                        <%= message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                    <% if (typeof uploadResult !== 'undefined' && uploadResult && uploadResult.mapping_detailed) { %>
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card mapping-card shadow-sm border-0">
                                <div class="card-body">
                                    <h5 class="mb-3">
                                        <i class="fas fa-exchange-alt me-2"></i>
                                        Mapping Tipe Case Otomatis Berlaku
                                    </h5>
                                    <div class="row">
                                        <% uploadResult.mapping_detailed.forEach(function(m) { %>
                                        <div class="col-md-6 col-lg-4 mb-2">
                                            <div class="mapping-item">
                                                <span class="old-label"><%= m.old %></span>
                                                <i class="fas fa-arrow-right arrow-icon"></i>
                                                <span class="new-label"><%= m.new %></span>
                                            </div>
                                        </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <% if (typeof uploadResult !== 'undefined' && uploadResult && uploadResult.cases && uploadResult.cases.length > 0) { %>
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm bg-primary text-white">
                                <div class="card-body text-center">
                                    <div class="display-5 fw-bold"><%= uploadResult.total_files %></div>
                                    <div class="small opacity-75 text-uppercase fw-bold">Total File</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm bg-success text-white">
                                <div class="card-body text-center">
                                    <div class="display-5 fw-bold"><%= uploadResult.success_count %></div>
                                    <div class="small opacity-75 text-uppercase fw-bold">Case Berhasil Dibuat</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm bg-danger text-white">
                                <div class="card-body text-center">
                                    <div class="display-5 fw-bold"><%= uploadResult.fail_count %></div>
                                    <div class="small opacity-75 text-uppercase fw-bold">Gagal Diproses</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm bg-info text-white">
                                <div class="card-body text-center">
                                    <div class="display-5 fw-bold"><%= uploadResult.case_types_used ? uploadResult.case_types_used.length : 0 %></div>
                                    <div class="small opacity-75 text-uppercase fw-bold">Jenis Tipe Case</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <div class="row mb-5">
                        <div class="col-md-7">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-cloud-upload-alt me-2 text-primary"></i>
                                        Upload File JSON (Maksimal 2 File)
                                    </h5>
                                </div>
                                <form method="POST" action="/upload-json-cases" enctype="multipart/form-data">
                                    <div class="card-body">
                                        <label for="json_files" class="file-drop-zone d-block">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <h6 class="fw-bold mb-2 text-slate-700">
                                                Klik untuk Pilih File JSON
                                            </h6>
                                            <p class="text-muted small mb-0">
                                                Anda bisa memilih <strong>1 atau 2 file</strong> sekaligus. 
                                                Format file harus <code>.json</code> sesuai schema OneKlinik AI Claim Result.
                                            </p>
                                            <input 
                                                type="file" 
                                                id="json_files" 
                                                name="json_files" 
                                                accept=".json,application/json" 
                                                multiple 
                                                class="d-none"
                                                onchange="updateFileLabels(this)">
                                        </label>
                                        <div id="selected-files" class="mt-3"></div>
                                    </div>
                                    <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                                        <a href="/all-cases" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-times me-1"></i>Batal
                                        </a>
                                        <button type="submit" id="submitBtn" class="btn btn-primary shadow-sm px-4" disabled>
                                            <i class="fas fa-upload me-2"></i>
                                            Upload & Proses JSON
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <div class="card mt-3 border-0 shadow-sm">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-info-circle me-2 text-info"></i>
                                        Keterangan Format & Validasi
                                    </h5>
                                </div>
                                <div class="card-body text-sm">
                                    <h6 class="fw-bold mb-3">Field Wajib dalam JSON:</h6>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <ul class="mb-0">
                                                <li><code>schema_version</code></li>
                                                <li><code>processing_id</code></li>
                                                <li><code>request_ref</code> (object)</li>
                                                <li><code>line_of_business</code> (health/life/general)</li>
                                                <li><code>documents</code> (array)</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="mb-0">
                                                <li><code>assessment</code> (object)</li>
                                                <li><code>audit</code> (object)</li>
                                                <li><code>retention</code> (object)</li>
                                                <li><code>extracted_data</code> (untuk v0.2)</li>
                                                <li><code>policy_evaluation</code> (untuk v0.1)</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <hr>
                                    <h6 class="fw-bold mb-2">Pemetaan Case Type:</h6>
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td><i class="fas fa-check text-primary me-2"></i><strong>Klaim rawat inap / perawatan rumah sakit</strong></td>
                                            <td><span class="case-type-badge type-hospital">Klaim Hospital</span></td>
                                        </tr>
                                        <tr>
                                            <td><i class="fas fa-check text-primary me-2"></i><strong>Klaim jiwa / penyakit kritis</strong></td>
                                            <td><span class="case-type-badge type-non-hospital">Klaim Non Hospital</span></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-lightbulb me-2 text-warning"></i>
                                        Langkah-langkah
                                    </h5>
                                </div>
                                <div class="card-body text-sm">
                                    <ol class="mb-0 ps-3">
                                        <li class="mb-3">
                                            <strong>Pilih file JSON:</strong> 
                                            Klik area upload dan pilih 1 atau 2 file JSON dari folder.
                                        </li>
                                        <li class="mb-3">
                                            <strong>Klik Upload & Proses:</strong> 
                                            Sistem akan memvalidasi schema dan mem-parsing isi kedua file.
                                        </li>
                                        <li class="mb-3">
                                            <strong>Mapping tipe case:</strong> 
                                            Sistem mengelompokkan klaim rawat inap sebagai Klaim Hospital dan klaim jiwa atau penyakit kritis sebagai Klaim Non Hospital.
                                        </li>
                                        <li class="mb-3">
                                            <strong>Case dibuat otomatis:</strong> 
                                            Setiap file JSON menjadi 1 record case baru di database dengan json_data terlampir.
                                        </li>
                                        <li>
                                            <strong>Lihat hasil:</strong> 
                                            Semua data dari kedua file ditampilkan lengkap di halaman ini beserta link ke detail case.
                                        </li>
                                    </ol>
                                </div>
                            </div>

                            <div class="card mt-3 border-0 shadow-sm">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-folder me-2 text-success"></i>
                                        Contoh File JSON
                                    </h5>
                                </div>
                                <div class="card-body text-sm">
                                    <p class="mb-2">Gunakan file contoh di folder <code>file json/</code> untuk pengujian:</p>
                                    <ul class="mb-0">
                                        <li><code>contoh-1-health-approve.json</code> → <span class="case-type-badge type-hospital">Klaim Hospital</span></li>
                                        <li><code>contoh-2-health-human-review.json</code> → <span class="case-type-badge type-hospital">Klaim Hospital</span></li>
                                        <li><code>contoh-3-life-refer-investigation.json</code> → <span class="case-type-badge type-non-hospital">Klaim Non Hospital</span></li>
                                        <li><code>contoh-4-life-death-diterima.json</code> → <span class="case-type-badge type-non-hospital">Klaim Non Hospital</span></li>
                                        <li><code>contoh-5-life-critical-illness.json</code> → <span class="case-type-badge type-non-hospital">Klaim Non Hospital</span></li>
                                        <li><code>contoh-6-life-critical-care-hold.json</code> → <span class="case-type-badge type-non-hospital">Klaim Non Hospital</span></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (typeof uploadResult !== 'undefined' && uploadResult && uploadResult.cases && uploadResult.cases.length > 0) { %>
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-layer-group me-2 text-dark"></i>
                                        Ringkasan Case yang Berhasil Dibuat
                                        (<%= uploadResult.cases.length %> dari <%= uploadResult.total_files %> file)
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0 align-middle">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="px-4 py-3">Case ID</th>
                                                    <th class="px-4 py-3">File Sumber</th>
                                                    <th class="px-4 py-3">Case Type</th>
                                                    <th class="px-4 py-3">No. Klaim / Processing ID</th>
                                                    <th class="px-4 py-3">Tertanggung</th>
                                                    <th class="px-4 py-3">Status / Rekomendasi</th>
                                                    <th class="px-4 py-3">Aksi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% uploadResult.cases.forEach(function(c, idx) { %>
                                                <tr>
                                                    <td class="px-4">
                                                        <strong class="text-primary fs-5">#<%= c.case_id %></strong>
                                                    </td>
                                                    <td class="px-4">
                                                        <small class="text-muted d-block mb-1">File <%= idx + 1 %></small>
                                                        <code><%= c.file_name %></code>
                                                    </td>
                                                    <td class="px-4">
                                                        <span class="case-type-badge <%= ['health', 'hospital', 'kesehatan', 'klaim hospital'].includes(String(c.type || '').toLowerCase()) ? 'type-hospital' : 'type-non-hospital' %>"><%= ['health', 'hospital', 'kesehatan', 'klaim hospital'].includes(String(c.type || '').toLowerCase()) ? 'Klaim Hospital' : 'Klaim Non Hospital' %></span>
                                                    </td>
                                                    <td class="px-4">
                                                        <small>
                                                            <div><strong>No. Klaim:</strong> <%= c.tpa_claim_id %></div>
                                                            <div class="text-muted"><strong>Proc ID:</strong> <%= c.processing_id %></div>
                                                        </small>
                                                    </td>
                                                    <td class="px-4">
                                                        <%= c.tertanggung %>
                                                        <% if (c.summary && c.summary.date_of_birth) { %>
                                                        <small class="text-muted d-block">
                                                            Tgl Lahir: <%= c.summary.date_of_birth %>
                                                        </small>
                                                        <% } %>
                                                    </td>
                                                    <td class="px-4">
                                                        <span class="status-badge bg-<%= c.recommendation === 'approve' ? 'success' : (c.recommendation === 'reject' ? 'danger' : (c.recommendation === 'hold' ? 'warning' : 'info')) %> text-white">
                                                            <%= c.status_claim || c.recommendation %>
                                                        </span>
                                                        <% if (c.confidence !== null && c.confidence !== undefined) { %>
                                                        <small class="d-block mt-1 text-muted">
                                                            Confidence: <%= (c.confidence * 100).toFixed(0) %>%
                                                        </small>
                                                        <% } %>
                                                    </td>
                                                    <td class="px-4">
                                                        <a href="/case/<%= c.case_id %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                            <i class="fas fa-eye me-1"></i>Detail
                                                        </a>
                                                        <a href="/case/<%= c.case_id %>/pdf" target="_blank" class="btn btn-sm btn-outline-danger mt-1">
                                                            <i class="fas fa-file-pdf me-1"></i>PDF
                                                        </a>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <h4 class="mb-3 fw-bold">
                                <i class="fas fa-database me-2 text-primary"></i>
                                Detail Lengkap Data dari Kedua File JSON
                            </h4>
                        </div>
                    </div>

                    <% uploadResult.cases.forEach(function(c, idx) { %>
                    <div class="row mb-5">
                        <div class="col-md-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-<%= idx % 2 === 0 ? 'primary' : 'success' %> text-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="fas fa-file-alt me-2"></i>
                                        FILE <%= idx + 1 %>: <%= c.file_name %>
                                        <span class="ms-3">Case ID: #<%= c.case_id %></span>
                                    </h5>
                                    <span class="case-type-badge" style="background-color:rgba(255,255,255,0.3);color:white;"><%= ['health', 'hospital', 'kesehatan', 'klaim hospital'].includes(String(c.type || '').toLowerCase()) ? 'Klaim Hospital' : 'Klaim Non Hospital' %></span>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row g-4 mb-4">
                                        <div class="col-lg-6">
                                            <div class="card section-card h-100 border-0 bg-light">
                                                <div class="card-body">
                                                    <h6 class="fw-bold mb-3 text-primary">
                                                        <i class="fas fa-id-card me-2"></i>
                                                        Informasi Utama & Referensi
                                                    </h6>
                                                    <div class="data-row">
                                                        <div class="data-label">Case ID (DB)</div>
                                                        <div class="data-value"><strong>#<%= c.case_id %></strong></div>
                                                    </div>
                                                    <div class="data-row">
                                                        <div class="data-label">No. Klaim (TPA)</div>
                                                        <div class="data-value"><%= c.tpa_claim_id %></div>
                                                    </div>
                                                    <div class="data-row">
                                                        <div class="data-label">Processing ID</div>
                                                        <div class="data-value"><%= c.processing_id %></div>
                                                    </div>
                                                    <div class="data-row">
                                                        <div class="data-label">Line of Business</div>
                                                        <div class="data-value"><%= c.line_of_business %></div>
                                                    </div>
