    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
    <script>
        function updateFileLabels(input) {
            const container = document.getElementById('selected-files');
            const submitBtn = document.getElementById('submitBtn');
            const files = input.files;
            container.innerHTML = '';

            if (files.length === 0) {
                submitBtn.disabled = true;
                return;
            }

            if (files.length > 2) {
                container.innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Maksimal <strong>2 file</strong>! Anda memilih ${files.length} file. Silakan pilih ulang.
                    </div>`;
                submitBtn.disabled = true;
                return;
            }

            submitBtn.disabled = false;
            let totalSize = 0;
            const wrapper = document.createElement('div');
            wrapper.className = 'd-flex flex-wrap gap-2';

            for (let i = 0; i < files.length; i++) {
                const f = files[i];
                totalSize += f.size;
                const sizeKB = (f.size / 1024).toFixed(1);
                const badge = document.createElement('div');
                badge.className = 'alert alert-info mb-0 py-2 px-3 d-flex align-items-center gap-2';
                badge.innerHTML = `
                    <i class="fas fa-file-code text-primary fs-5"></i>
                    <div>
                        <div class="fw-bold small">${i + 1}. ${f.name}</div>
                        <div class="text-muted small">${sizeKB} KB</div>
                    </div>
                `;
                wrapper.appendChild(badge);
            }
            const total = document.createElement('div');
            total.className = 'w-100 mt-2 text-muted small';
            total.innerHTML = `<i class="fas fa-info-circle me-1"></i>Total: ${files.length} file, ${(totalSize / 1024).toFixed(1)} KB`;
            wrapper.appendChild(total);
            container.appendChild(wrapper);
        }

        function copyToClipboard(elementId) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const txt = el.innerText;
            navigator.clipboard.writeText(txt).then(function() {
                alert('JSON berhasil disalin ke clipboard!');
            }).catch(function() {
                alert('Gagal menyalin JSON.');
            });
        }

        function toggleRawJson(elementId, btn) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const lbl = btn.querySelector('.lbl');
            if (el.style.display === 'none') {
                el.style.display = 'block';
                lbl.textContent = 'Sembunyikan';
                btn.querySelector('i').className = 'fas fa-eye-slash me-1';
            } else {
                el.style.display = 'none';
                lbl.textContent = 'Lihat';
                btn.querySelector('i').className = 'fas fa-eye me-1';
            }
        }

        document.querySelectorAll('.file-drop-zone').forEach(function(zone) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function(evt) {
                zone.addEventListener(evt, function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }, false);
            });
            ['dragenter', 'dragover'].forEach(function(evt) {
                zone.addEventListener(evt, function() {
                    zone.classList.add('active');
                }, false);
            });
            ['dragleave', 'drop'].forEach(function(evt) {
                zone.addEventListener(evt, function() {
                    zone.classList.remove('active');
                }, false);
            });
            zone.addEventListener('drop', function(e) {
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    const input = document.getElementById('json_files');
                    if (input) {
                        const dt = new DataTransfer();
                        for (let i = 0; i < Math.min(files.length, 2); i++) {
                            dt.items.add(files[i]);
                        }
                        input.files = dt.files;
                        updateFileLabels(input);
                    }
                }
            }, false);
        });
    </script>
</body>
</html>
