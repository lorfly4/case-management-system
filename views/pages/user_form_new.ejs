<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user ? 'Edit User' : 'Create New User' %> - Case Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
            <div class="navbar-brand fw-bold ms-3">
                <i class="fas fa-briefcase"></i> <%= user ? 'Edit User' : 'Create New User' %>
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header">
                            <strong><%= currentUser %></strong>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/dashboard" class="brand-link">
                <i class="fas fa-briefcase brand-image"></i>
                <span class="brand-text font-weight-light">CMS</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/dashboard" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Cases <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/all-cases" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Cases</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/case/new" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Create Case</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="/import-cases" class="nav-link">
                                <i class="nav-icon fas fa-file-upload"></i>
                                <p>Import Cases</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/users" class="nav-link active">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0"><%= user ? 'Edit User #' + user.id : 'Create New User' %></h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Alert Messages -->
                    <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i><%= message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">User Form</h5>
                                </div>
                                <form method="POST" action="<%= user ? '/user/' + user.id + '/edit' : '/user/new' %>">
                                    <div class="card-body">
                                        <div class="form-group mb-3">
                                            <label for="username">Username <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="username" name="username" 
                                                   value="<%= user ? user.username : '' %>" 
                                                   <%= user ? 'readonly' : 'placeholder="Enter username"' %> required>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="email">Email <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control" id="email" name="email" 
                                                   value="<%= user ? user.email : '' %>" 
                                                   placeholder="Enter email address" required>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="password">Password <span class="text-danger">*</span></label>
                                            <input type="password" class="form-control" id="password" name="password" 
                                                   placeholder="<%= user ? 'Leave blank to keep current password' : 'Enter password' %>" 
                                                   <%= user ? '' : 'required' %>>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="passwordConfirm">Confirm Password <span class="text-danger">*</span></label>
                                            <input type="password" class="form-control" id="passwordConfirm" name="passwordConfirm" 
                                                   placeholder="<%= user ? 'Leave blank to keep current password' : 'Confirm password' %>" 
                                                   <%= user ? '' : 'required' %>>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="role">Role <span class="text-danger">*</span></label>
                                            <select class="form-control" id="role" name="role" required>
                                                <option value="">-- Select Role --</option>
                                                <% roles.forEach(r => { %>
                                                <option value="<%= r %>" <%= user && user.role === r ? 'selected' : '' %>>
                                                    <%= r.toUpperCase() %>
                                                </option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <% if (user) { %>
                                        <div class="alert alert-info alert-sm">
                                            <strong>Account Information:</strong><br>
                                            Created: <%= new Date(user.created_at).toLocaleDateString('id-ID') %>
                                        </div>
                                        <% } %>
                                    </div>

                                    <div class="card-footer bg-light">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save me-2"></i><%= user ? 'Update User' : 'Create User' %>
                                        </button>
                                        <a href="/users" class="btn btn-secondary ms-2">
                                            <i class="fas fa-times me-2"></i>Cancel
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Info Sidebar -->
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">User Roles</h5>
                                </div>
                                <div class="card-body text-sm">
                                    <p><strong>Admin:</strong> Full access to all system features and user management</p>
                                    <p><strong>SPV:</strong> Can create cases, assign PIC, and manage case workflow</p>
                                    <p><strong>User:</strong> Can view assigned cases and update case status</p>
                                    <div class="alert alert-info alert-sm" role="alert">
                                        Fields marked with <span class="text-danger">*</span> are required
                                    </div>
                                </div>
                            </div>

                            <% if (user) { %>
                            <div class="card mt-3">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Account Status</h5>
                                </div>
                                <div class="card-body">
                                    <p><strong>Username:</strong> <%= user.username %></p>
                                    <p><strong>Email:</strong> <%= user.email %></p>
                                    <p><strong>Role:</strong> <span class="badge badge-info"><%= user.role.toUpperCase() %></span></p>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Case Management System &copy; 2026</strong> - Built for Efficiency
            <div class="float-end d-none d-sm-inline">
                <b>Version</b> 1.0
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
</body>
</html>
