<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Cases - Case Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
            <div class="navbar-brand fw-bold ms-3">
                <i class="fas fa-briefcase"></i> All Cases
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header">
                            <strong><%= user %></strong> - <%= role.toUpperCase() %>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/dashboard" class="brand-link">
                <i class="fas fa-briefcase brand-image"></i>
                <span class="brand-text font-weight-light">CMS</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/dashboard" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link active">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Cases <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview menu-open">
                                <li class="nav-item">
                                    <a href="/all-cases" class="nav-link active">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Cases</p>
                                    </a>
                                </li>
                                <% if (role === 'admin' || role === 'spv') { %>
                                <li class="nav-item">
                                    <a href="/case/new" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Create Case</p>
                                    </a>
                                </li>
                                <% } %>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="/import-cases" class="nav-link">
                                <i class="nav-icon fas fa-file-upload"></i>
                                <p>Import Cases</p>
                            </a>
                        </li>
                        <% if (role === 'admin') { %>
                        <li class="nav-item">
                            <a href="/users" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">All Cases</h1>
                        </div>
                        <div class="col-sm-6 text-end">
                            <a href="/case/new" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-2"></i>Create Case
                            </a>
                            <a href="/import-cases" class="btn btn-success btn-sm ms-2">
                                <i class="fas fa-file-excel me-2"></i>Import Excel
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Alert Messages -->
                    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i><%= successMessage %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                    <!-- Cases Table -->
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-table me-2"></i>Cases List
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="casesTable" class="table table-hover table-striped">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Case ID</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>PIC</th>
                                            <th>Created Date</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof cases !== 'undefined' && cases.length > 0) {
                                            cases.forEach(caseItem => { %>
                                            <tr>
                                                <td data-order="<%= caseItem.id %>"><strong>#<%= caseItem.id %></strong></td>
                                                <td>
                                                    <span class="badge badge-<%= caseItem.type === 'Regular Case' ? 'primary' : (caseItem.type === 'On-Desk Case' ? 'success' : 'info') %>">
                                                        <%= caseItem.type %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge badge-<%= caseItem.status === 'Closed' ? 'success' : (caseItem.status === 'In Progress' ? 'warning' : 'secondary') %>">
                                                        <%= caseItem.status %>
                                                    </span>
                                                </td>
                                                <td><%= caseItem.pic_name || 'Unassigned' %></td>
                                                <td><%= new Date(caseItem.created_at).toLocaleDateString('id-ID') %></td>
                                                <td>
                                                    <a href="/case/<%= caseItem.id %>" class="btn btn-sm btn-info text-white" title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <% if ((role === 'admin' || role === 'spv') && caseItem.status !== 'Closed') { %>
                                                    <button type="button" class="btn btn-sm btn-success text-white ms-1" onclick="openAssignModal('<%= caseItem.id %>', '#<%= caseItem.id %>')" title="Pilih PIC">
                                                        <i class="fas fa-user-plus"></i>
                                                    </button>
                                                    <a href="/case/<%= caseItem.id %>/edit" class="btn btn-sm btn-warning text-white ms-1" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% });
                                        } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">
                                                    <i class="fas fa-inbox fa-2x mb-2"></i><br>
                                                    No cases found
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Case Management System &copy; 2026</strong> - Built for Efficiency
            <div class="float-end d-none d-sm-inline">
                <b>Version</b> 1.0
            </div>
        </footer>
    </div>

    <!-- Modal Pilih PIC -->
    <% if (role === 'admin' || role === 'spv') { %>
    <div class="modal fade" id="assignPicModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-user-plus me-2"></i>Pilih PIC Kasus
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="assignForm">
                    <div class="modal-body p-4">
                        <input type="hidden" name="case_id" id="modal_case_id">
                        <div class="mb-4">
                        <label class="text-muted small fw-bold text-uppercase mb-1 d-block">ID Kasus</label>
                        <h5 id="modal_case_number" class="fw-bold text-dark"></h5>
                    </div>
                        <div class="mb-3">
                            <label for="pic_id" class="form-label fw-bold">Pilih Pengguna:</label>
                            <select id="pic_id" name="pic_id" class="form-select form-select-lg" required>
                                <option value="">- Pilih Pengguna -</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer bg-light p-3">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="fas fa-check me-2"></i>Simpan Perubahan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <% } %>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(function() {
            $('#casesTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "order": [[0, "desc"]],
                "columnDefs": [
                    { "type": "num", "targets": 0 }
                ],
                "dom": '<"d-flex justify-content-between align-items-center mb-3"lBf>rtip',
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel me-1"></i> Export to Excel',
                        className: 'btn btn-success btn-sm',
                        title: 'All Cases Data',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4] // Export Case ID, Type, Status, PIC, Created Date
                        }
                    }
                ]
            });

            // Load users for PIC assignment dropdown
            <% if (role === 'admin' || role === 'spv') { %>
            $.ajax({
                url: '/api/users-with-load',
                method: 'GET',
                success: function(data) {
                    data.forEach(user => {
                        $('#pic_id').append(`<option value="${user.id}">${user.username} (${user.load_count} kasus aktif)</option>`);
                    });
                }
            });
            <% } %>

            // Handle Assign PIC form submission
            $('#assignForm').on('submit', function(e) {
                e.preventDefault();
                const btn = $(this).find('button[type="submit"]');
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Menyimpan...');
                
                $.ajax({
                    url: '/assign-case',
                    method: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + (response.error || 'Gagal menentukan PIC'));
                            btn.prop('disabled', false).html('<i class="fas fa-check me-2"></i>Simpan Perubahan');
                        }
                    }
                });
            });
        });

        function openAssignModal(id, number) {
            $('#modal_case_id').val(id);
            $('#modal_case_number').text(number);
            const modal = new bootstrap.Modal(document.getElementById('assignPicModal'));
            modal.show();
        }
    </script>
</body>
</html>