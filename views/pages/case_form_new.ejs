<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= caseItem ? 'Edit Case' : 'Create New Case' %> - Case Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
            <div class="navbar-brand fw-bold ms-3">
                <i class="fas fa-briefcase"></i> <%= caseItem ? 'Edit Case' : 'Create New Case' %>
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header">
                            <strong><%= user %></strong> - <%= role.toUpperCase() %>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/dashboard" class="brand-link">
                <i class="fas fa-briefcase brand-image"></i>
                <span class="brand-text font-weight-light">CMS</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/dashboard" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link active">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Cases <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview menu-open">
                                <li class="nav-item">
                                    <a href="/all-cases" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Cases</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/case/new" class="nav-link active">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p><%= caseItem ? 'Edit Case' : 'Create Case' %></p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="/import-cases" class="nav-link">
                                <i class="nav-icon fas fa-file-upload"></i>
                                <p>Import Cases</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/users" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0"><%= caseItem ? 'Edit Case #' + caseItem.id : 'Create New Case' %></h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Alert Messages -->
                    <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i><%= message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Case Form</h5>
                                </div>
                                <form method="POST" action="<%= caseItem ? '/case/' + caseItem.id + '/edit' : '/case/new' %>">
                                    <div class="card-body">
                                        <div class="form-group mb-3">
                                            <label for="type">Case Type <span class="text-danger">*</span></label>
                                            <select class="form-control" id="type" name="type" required>
                                                <option value="">-- Select Type --</option>
                                                <% caseTypes.forEach(t => { %>
                                                <option value="<%= t %>" <%= caseItem && caseItem.type === t ? 'selected' : '' %>>
                                                    <%= t %>
                                                </option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="title">Case Title <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="title" name="title" 
                                                   value="<%= caseItem ? caseItem.title : '' %>" 
                                                   placeholder="Enter case title" required>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="description">Description</label>
                                            <textarea class="form-control" id="description" name="description" 
                                                      placeholder="Enter case description" rows="5"><%= caseItem ? caseItem.description : '' %></textarea>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="priority">Priority <span class="text-danger">*</span></label>
                                                    <select class="form-control" id="priority" name="priority" required>
                                                        <option value="Low" <%= caseItem && caseItem.priority === 'Low' ? 'selected' : '' %>>Low</option>
                                                        <option value="Medium" <%= !caseItem || caseItem.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
                                                        <option value="High" <%= caseItem && caseItem.priority === 'High' ? 'selected' : '' %>>High</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="status">Status <span class="text-danger">*</span></label>
                                                    <select class="form-control" id="status" name="status" required>
                                                        <option value="Unassigned" <%= !caseItem || caseItem.status === 'Unassigned' ? 'selected' : '' %>>Unassigned</option>
                                                        <option value="In Progress" <%= caseItem && caseItem.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                                                        <option value="On Hold" <%= caseItem && caseItem.status === 'On Hold' ? 'selected' : '' %>>On Hold</option>
                                                        <option value="Closed" <%= caseItem && caseItem.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Informasi Polis</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="no_polis">No. Polis</label>
                                                    <input type="text" class="form-control" id="no_polis" name="no_polis" value="<%= caseItem ? (caseItem.no_polis || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="pemegang_polis">Pemegang Polis</label>
                                                    <input type="text" class="form-control" id="pemegang_polis" name="pemegang_polis" value="<%= caseItem ? (caseItem.pemegang_polis || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tertanggung">Tertanggung</label>
                                                    <input type="text" class="form-control" id="tertanggung" name="tertanggung" value="<%= caseItem ? (caseItem.tertanggung || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tanggal_issued_polis">Tanggal Issued Polis</label>
                                                    <input type="date" class="form-control" id="tanggal_issued_polis" name="tanggal_issued_polis" value="<%= caseItem && caseItem.tanggal_issued_polis ? new Date(caseItem.tanggal_issued_polis).toISOString().slice(0,10) : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="jenis_claim">Jenis Claim</label>
                                                    <input type="text" class="form-control" id="jenis_claim" name="jenis_claim" value="<%= caseItem ? (caseItem.jenis_claim || '') : '' %>" placeholder="Regular Case">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="up">UP</label>
                                                    <input type="number" class="form-control" id="up" name="up" value="<%= caseItem ? (caseItem.up || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="usia_polis">Usia Polis</label>
                                                    <input type="text" class="form-control" id="usia_polis" name="usia_polis" value="<%= caseItem ? (caseItem.usia_polis || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="pekerjaan_tertanggung">Pekerjaan Tertanggung</label>
                                                    <input type="text" class="form-control" id="pekerjaan_tertanggung" name="pekerjaan_tertanggung" value="<%= caseItem ? (caseItem.pekerjaan_tertanggung || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group mb-3">
                                                    <label for="alamat">Alamat</label>
                                                    <textarea class="form-control" id="alamat" name="alamat" rows="2"><%= caseItem ? (caseItem.alamat || '') : '' %></textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Informasi Klaim</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tanggal_meninggal">Tanggal Meninggal</label>
                                                    <input type="date" class="form-control" id="tanggal_meninggal" name="tanggal_meninggal" value="<%= caseItem && caseItem.tanggal_meninggal ? new Date(caseItem.tanggal_meninggal).toISOString().slice(0,10) : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="penyebab_meninggal">Penyebab Meninggal</label>
                                                    <input type="text" class="form-control" id="penyebab_meninggal" name="penyebab_meninggal" value="<%= caseItem ? (caseItem.penyebab_meninggal || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tempat_meninggal">Tempat Meninggal</label>
                                                    <input type="text" class="form-control" id="tempat_meninggal" name="tempat_meninggal" value="<%= caseItem ? (caseItem.tempat_meninggal || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="pengaju_klaim">Pengaju Klaim</label>
                                                    <input type="text" class="form-control" id="pengaju_klaim" name="pengaju_klaim" value="<%= caseItem ? (caseItem.pengaju_klaim || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group mb-3">
                                                    <label for="kronologi_singkat">Kronologi Singkat</label>
                                                    <textarea class="form-control" id="kronologi_singkat" name="kronologi_singkat" rows="3"><%= caseItem ? (caseItem.kronologi_singkat || '') : '' %></textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Claim Assesment</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="status_claim">Status Claim</label>
                                                    <input type="text" class="form-control" id="status_claim" name="status_claim" value="<%= caseItem ? (caseItem.status_claim || '') : 'Unassigned' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="hasil_assesment">Hasil Assesment</label>
                                                    <input type="text" class="form-control" id="hasil_assesment" name="hasil_assesment" value="<%= caseItem ? (caseItem.hasil_assesment || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group mb-3">
                                                    <label for="dasar_ketentuan">Dasar Ketentuan</label>
                                                    <textarea class="form-control" id="dasar_ketentuan" name="dasar_ketentuan" rows="2"><%= caseItem ? (caseItem.dasar_ketentuan || '') : '' %></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-footer bg-light">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save me-2"></i><%= caseItem ? 'Update Case' : 'Create Case' %>
                                        </button>
                                        <a href="/all-cases" class="btn btn-secondary ms-2">
                                            <i class="fas fa-times me-2"></i>Cancel
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Info Sidebar -->
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Instructions</h5>
                                </div>
                                <div class="card-body text-sm">
                                    <p><strong>Case Number:</strong> Unique identifier for the case</p>
                                    <p><strong>Type:</strong> Category of the case (Regular, On-Desk, or Reliance)</p>
                                    <p><strong>Priority:</strong> Urgency level (Low, Medium, High)</p>
                                    <p><strong>Status:</strong> Current stage of the case</p>
                                    <div class="alert alert-info alert-sm" role="alert">
                                        Fields marked with <span class="text-danger">*</span> are required
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Case Management System &copy; 2026</strong> - Built for Efficiency
            <div class="float-end d-none d-sm-inline">
                <b>Version</b> 1.0
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
</body>
</html>
