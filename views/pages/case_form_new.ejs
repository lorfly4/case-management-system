<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= caseItem ? 'Edit Case' : 'Create New Case' %> - Deswa Management System</title>
        <link rel="icon" href="/images/logo.jpeg" type="image/jpeg">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
            <div class="navbar-brand fw-bold ms-3">
                <i class="fas fa-briefcase"></i> <%= caseItem ? 'Edit Case' : 'Create New Case' %>
            </div>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header">
                            <strong><%= user %></strong> - <%= role.toUpperCase() %>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/dashboard" class="brand-link">
                <img src="/images/logo.jpeg" alt="Deswa Management System logo" class="brand-image img-circle elevation-3">
                <span class="brand-text font-weight-light">Deswa Management System</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/dashboard" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link active">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Cases <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview menu-open">
                                <li class="nav-item">
                                    <a href="/all-cases" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Cases</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/case/new" class="nav-link active">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p><%= caseItem ? 'Edit Case' : 'Create Case' %></p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="/import-cases" class="nav-link">
                                <i class="nav-icon fas fa-file-upload"></i>
                                <p>Import Cases</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/users" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0"><%= caseItem ? 'Edit Case #' + caseItem.id : 'Create New Case' %></h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Alert Messages -->
                    <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i><%= message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Case Form</h5>
                                </div>
                                <form method="POST" enctype="multipart/form-data" action="<%= caseItem ? '/case/' + caseItem.id + '/edit' : '/case/new' %>">
                                    <div class="card-body">
                                        <div class="form-group mb-3">
                                            <label for="case_type">Case Type <span class="text-danger">*</span></label>
                                            <select class="form-control" id="case_type" name="case_type" required>
                                                <option value="">Pilih jenis klaim</option>
                                                <% caseTypes.forEach(t => { %>
                                                <option value="<%= t %>" <%= (caseItem && caseItem.case_type === t) || (!caseItem && claimData.category === t) || (caseItem && !caseItem.case_type && claimData.category === t) ? 'selected' : '' %>><%= t %></option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="title">Case Title <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="title" name="title" 
                                                   value="<%= caseItem ? caseItem.title : '' %>" 
                                                   placeholder="Enter case title" required>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="description">Description</label>
                                            <textarea class="form-control" id="description" name="description" 
                                                      placeholder="Enter case description" rows="5"><%= caseItem ? caseItem.description : '' %></textarea>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="priority">Priority <span class="text-danger">*</span></label>
                                                    <select class="form-control" id="priority" name="priority" required>
                                                        <option value="Low" <%= caseItem && caseItem.priority === 'Low' ? 'selected' : '' %>>Low</option>
                                                        <option value="Medium" <%= !caseItem || caseItem.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
                                                        <option value="High" <%= caseItem && caseItem.priority === 'High' ? 'selected' : '' %>>High</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="status">Status <span class="text-danger">*</span></label>
                                                    <select class="form-control" id="status" name="status" required>
                                                        <option value="Unassigned" <%= !caseItem || caseItem.status === 'Unassigned' ? 'selected' : '' %>>Unassigned</option>
                                                        <option value="In Progress" <%= caseItem && caseItem.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                                                        <option value="On Hold" <%= caseItem && caseItem.status === 'On Hold' ? 'selected' : '' %>>On Hold</option>
                                                        <option value="Closed" <%= caseItem && caseItem.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Informasi Polis</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="no_polis">No. Polis</label>
                                                    <input type="text" class="form-control" id="no_polis" name="no_polis" value="<%= caseItem ? (caseItem.no_polis || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="pemegang_polis">Pemegang Polis</label>
                                                    <input type="text" class="form-control" id="pemegang_polis" name="pemegang_polis" value="<%= caseItem ? (caseItem.pemegang_polis || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tertanggung">Tertanggung</label>
                                                    <input type="text" class="form-control" id="tertanggung" name="tertanggung" value="<%= caseItem ? (caseItem.tertanggung || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tanggal_issued_polis">Tanggal Issued Polis</label>
                                                    <input type="date" class="form-control" id="tanggal_issued_polis" name="tanggal_issued_polis" value="<%= caseItem && caseItem.tanggal_issued_polis ? new Date(caseItem.tanggal_issued_polis).toISOString().slice(0,10) : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="jenis_claim">Jenis Claim</label>
                                                    <input type="text" class="form-control" id="jenis_claim" name="jenis_claim" value="<%= (caseItem && caseItem.case_type) || claimData.category || '' %>" readonly>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="up">UP</label>
                                                    <input type="text" inputmode="numeric" class="form-control currency-input" id="up" name="up" value="<%= caseItem && caseItem.up ? Number(caseItem.up).toLocaleString('id-ID') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="usia_polis">Usia Polis</label>
                                                    <input type="text" class="form-control" id="usia_polis" name="usia_polis" value="<%= caseItem ? (caseItem.usia_polis || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="pekerjaan_tertanggung">Pekerjaan Tertanggung</label>
                                                    <input type="text" class="form-control" id="pekerjaan_tertanggung" name="pekerjaan_tertanggung" value="<%= caseItem ? (caseItem.pekerjaan_tertanggung || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group mb-3">
                                                    <label for="alamat">Alamat</label>
                                                    <textarea class="form-control" id="alamat" name="alamat" rows="2"><%= caseItem ? (caseItem.alamat || '') : '' %></textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Informasi Polis Tambahan</h5>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="policy_payer">Pembayar Polis</label>
                                                <input class="form-control" id="policy_payer" name="policy_payer" value="<%= claimData.policy?.payer || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="policy_status_at_claim">Status Polis saat Klaim</label>
                                                <select class="form-control" id="policy_status_at_claim" name="policy_status_at_claim">
                                                    <option value="">Pilih status</option>
                                                    <% ['Aktif', 'Tidak Aktif', 'Lapse', 'Dalam Masa Tenggang', 'Lainnya'].forEach(status => { %>
                                                    <option value="<%= status %>" <%= claimData.policy?.status_at_claim === status ? 'selected' : '' %>><%= status %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="policy_claimed_benefit">Manfaat yang Diklaim</label>
                                                <input class="form-control" id="policy_claimed_benefit" name="policy_claimed_benefit" value="<%= claimData.policy?.claimed_benefit || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="policy_sum_insured">Nilai Pertanggungan (Rp)</label>
                                                <input type="text" inputmode="numeric" class="form-control currency-input" id="policy_sum_insured" name="policy_sum_insured" value="<%= claimData.policy?.sum_insured ? Number(claimData.policy.sum_insured).toLocaleString('id-ID') : '' %>">
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Informasi Klaim</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tanggal_meninggal">Tanggal Meninggal</label>
                                                    <input type="date" class="form-control" id="tanggal_meninggal" name="tanggal_meninggal" value="<%= caseItem && caseItem.tanggal_meninggal ? new Date(caseItem.tanggal_meninggal).toISOString().slice(0,10) : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="penyebab_meninggal">Penyebab Meninggal</label>
                                                    <input type="text" class="form-control" id="penyebab_meninggal" name="penyebab_meninggal" value="<%= caseItem ? (caseItem.penyebab_meninggal || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="tempat_meninggal">Tempat Meninggal</label>
                                                    <input type="text" class="form-control" id="tempat_meninggal" name="tempat_meninggal" value="<%= caseItem ? (caseItem.tempat_meninggal || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="pengaju_klaim">Pengaju Klaim</label>
                                                    <input type="text" class="form-control" id="pengaju_klaim" name="pengaju_klaim" value="<%= caseItem ? (caseItem.pengaju_klaim || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group mb-3">
                                                    <label for="kronologi_singkat">Kronologi Singkat</label>
                                                    <textarea class="form-control" id="kronologi_singkat" name="kronologi_singkat" rows="3"><%= caseItem ? (caseItem.kronologi_singkat || '') : '' %></textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Rincian Klaim</h5>

                                        <div id="hospitalFields" class="border rounded p-3 mb-3">
                                            <h6 class="font-weight-bold">Rincian Klaim Hospital</h6>
                                            <div class="row">
                                                <% [
                                                    ['room', 'Kamar Rawat Inap'], ['doctor', 'Biaya Dokter'],
                                                    ['procedure', 'Tindakan/Prosedur Medis'], ['medicines', 'Obat-obatan'],
                                                    ['laboratory', 'Laboratorium'], ['radiology', 'Radiologi (Rontgen, CT Scan, MRI)'],
                                                    ['other', 'Aneka Perawatan, Administrasi, dan Biaya Lainnya']
                                                ].forEach(([key, label]) => { %>
                                                <div class="col-md-6 mb-3">
                                                    <label for="cost_<%= key %>"><%= label %> (Rp)</label>
                                                    <input type="text" inputmode="numeric" class="form-control hospital-cost currency-input" id="cost_<%= key %>" name="cost_<%= key %>" value="<%= claimData.hospital?.costs?.[key] ? Number(claimData.hospital.costs[key]).toLocaleString('id-ID') : '' %>">
                                                </div>
                                                <% }); %>
                                            </div>
                                            <div class="row align-items-end">
                                                <div class="col-md-6 mb-3">
                                                    <label>Total Biaya Dijaminkan (Rp)</label>
                                                    <output id="hospitalTotal" class="form-control bg-light"><%= claimData.hospital?.guaranteed_total ?? 'Isi seluruh rincian biaya' %></output>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="hospital_submitted_amount">Klaim yang Diajukan (Rp)</label>
                                                    <input type="text" inputmode="numeric" class="form-control currency-input" id="hospital_submitted_amount" name="hospital_submitted_amount" value="<%= claimData.hospital?.submitted_amount ? Number(claimData.hospital.submitted_amount).toLocaleString('id-ID') : '' %>">
                                                </div>
                                            </div>
                                        </div>

                                        <div id="nonHospitalFields" class="border rounded p-3 mb-3">
                                            <h6 class="font-weight-bold">Rincian Klaim Non Hospital</h6>
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label for="non_hospital_sum_insured">Uang Pertanggungan yang Diajukan (Rp)</label>
                                                    <input type="text" inputmode="numeric" class="form-control currency-input" id="non_hospital_sum_insured" name="non_hospital_sum_insured" value="<%= claimData.non_hospital?.requested_sum_insured ? Number(claimData.non_hospital.requested_sum_insured).toLocaleString('id-ID') : '' %>">
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label for="non_hospital_benefit">Manfaat Nominal Klaim (Rp)</label>
                                                    <input type="text" inputmode="numeric" class="form-control currency-input" id="non_hospital_benefit" name="non_hospital_benefit" value="<%= claimData.non_hospital?.benefit_amount ? Number(claimData.non_hospital.benefit_amount).toLocaleString('id-ID') : '' %>">
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label for="non_hospital_approved">Klaim yang Disetujui (Rp)</label>
                                                    <input type="text" inputmode="numeric" class="form-control currency-input" id="non_hospital_approved" name="non_hospital_approved" value="<%= claimData.non_hospital?.approved_amount ? Number(claimData.non_hospital.approved_amount).toLocaleString('id-ID') : '' %>">
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Data Klaim dan Penerima Manfaat</h5>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="claim_number">No Klaim</label>
                                                <input class="form-control" id="claim_number" name="claim_number" value="<%= claimData.claim?.number || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="claim_kind">Jenis Klaim</label>
                                                <select class="form-control" id="claim_kind" name="claim_kind">
                                                    <option value="">Pilih jenis klaim</option>
                                                    <% ['Klaim rawat inap', 'Klaim perawatan 1 hari', 'Klaim Meninggal Dunia', 'Klaim Penyakit Kritis', 'Credit Life', 'Claim lainnya'].forEach(kind => { %>
                                                    <option value="<%= kind %>" <%= claimData.claim?.kind === kind ? 'selected' : '' %>><%= kind %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="critical_illness">Jenis Penyakit Kritis yang Terdiagnosa</label>
                                                <input class="form-control" id="critical_illness" name="critical_illness" value="<%= claimData.claim?.critical_illness || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="diagnosis_date">Tanggal Diagnosis Dokter</label>
                                                <input type="date" class="form-control" id="diagnosis_date" name="diagnosis_date" value="<%= claimData.claim?.diagnosis_date || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="admission_date">Tanggal Rawat Inap</label>
                                                <input type="date" class="form-control" id="admission_date" name="admission_date" value="<%= claimData.claim?.admission_date || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="incident_date">Tanggal Kejadian Klaim</label>
                                                <input type="date" class="form-control" id="incident_date" name="incident_date" value="<%= claimData.claim?.incident_date || '' %>">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="beneficiary_relationship">Hubungan dengan Pemegang Polis</label>
                                                <input class="form-control" id="beneficiary_relationship" name="beneficiary_relationship" value="<%= claimData.claim?.beneficiary_relationship || '' %>">
                                            </div>
                                            <div class="col-12 mb-3">
                                                <label for="beneficiary_data">Data Penerima Manfaat</label>
                                                <textarea class="form-control" id="beneficiary_data" name="beneficiary_data" rows="2"><%= claimData.claim?.beneficiary_data || '' %></textarea>
                                            </div>
                                        </div>

                                        <h6 class="font-weight-bold mt-2">Upload Dokumen</h6>
                                        <div class="row">
                                            <% [
                                                ['beneficiary_document', 'Data atau Dokumen Penerima Manfaat'],
                                                ['death_document', 'Dokumen Kematian'],
                                                ['identity_document', 'Dokumen Identitas'],
                                                ['medical_document', 'Dokumen Medis/Laporan Rumah Sakit'],
                                                ['police_document', 'Laporan Kepolisian (Jika Diperlukan)']
                                            ].forEach(([name, label]) => { %>
                                            <div class="col-md-6 mb-3">
                                                <label for="<%= name %>"><%= label %></label>
                                                <input type="file" class="form-control-file d-block" id="<%= name %>" name="<%= name %>" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png">
                                                <small class="form-text text-muted">PDF/JPG/PNG, maksimal 10 MB per file</small>
                                            </div>
                                            <% }); %>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Claim Assesment</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="status_claim">Status Claim</label>
                                                    <input type="text" class="form-control" id="status_claim" name="status_claim" value="<%= caseItem ? (caseItem.status_claim || '') : 'Unassigned' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group mb-3">
                                                    <label for="hasil_assesment">Hasil Assesment</label>
                                                    <input type="text" class="form-control" id="hasil_assesment" name="hasil_assesment" value="<%= caseItem ? (caseItem.hasil_assesment || '') : '' %>">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-group mb-3">
                                                    <label for="dasar_ketentuan">Dasar Ketentuan</label>
                                                    <textarea class="form-control" id="dasar_ketentuan" name="dasar_ketentuan" rows="2"><%= caseItem ? (caseItem.dasar_ketentuan || '') : '' %></textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <hr class="my-4">

                                        <h5 class="mb-3">Dokumen dan Verifikasi</h5>
                                        <div class="mb-3">
                                            <label class="d-block">Checklist Kelengkapan Dokumen</label>
                                            <% [
                                                ['beneficiary', 'Dokumen penerima manfaat'], ['death', 'Dokumen kematian'],
                                                ['identity', 'Dokumen identitas'], ['medical', 'Dokumen medis'],
                                                ['police', 'Laporan kepolisian']
                                            ].forEach(([value, label]) => { %>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" id="check_<%= value %>" name="document_checklist" value="<%= value %>" <%= (claimData.verification?.document_checklist || []).includes(value) ? 'checked' : '' %>>
                                                <label class="form-check-label" for="check_<%= value %>"><%= label %></label>
                                            </div>
                                            <% }); %>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="benefit_verified" name="benefit_verified" <%= claimData.verification?.benefit_verified ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="benefit_verified">Verifikasi manfaat</label>
                                                </div>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="policy_verified" name="policy_verified" <%= claimData.verification?.policy_verified ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="policy_verified">Verifikasi polis</label>
                                                </div>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="investigation_required" name="investigation_required" <%= claimData.verification?.investigation_required ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="investigation_required">Investigasi diperlukan</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="claim_decision">Keputusan Klaim</label>
                                                <select class="form-control" id="claim_decision" name="claim_decision">
                                                    <option value="">Belum diputuskan</option>
                                                    <% ['Disetujui', 'Disetujui Sebagian', 'Ditolak', 'Dalam Investigasi', 'Menunggu Dokumen'].forEach(decision => { %>
                                                    <option value="<%= decision %>" <%= claimData.verification?.decision === decision ? 'selected' : '' %>><%= decision %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-12 mb-3">
                                                <label for="assessor_notes">Catatan dari Klaim Assessor</label>
                                                <textarea class="form-control" id="assessor_notes" name="assessor_notes" rows="3"><%= claimData.verification?.assessor_notes || '' %></textarea>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-footer bg-light">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save me-2"></i><%= caseItem ? 'Update Case' : 'Create Case' %>
                                        </button>
                                        <a href="/all-cases" class="btn btn-secondary ms-2">
                                            <i class="fas fa-times me-2"></i>Cancel
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Info Sidebar -->
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Instructions</h5>
                                </div>
                                <div class="card-body text-sm">
                                    <p><strong>Case Number:</strong> Unique identifier for the case</p>
                                    <p><strong>Case Type:</strong> Klaim Hospital atau Klaim Non Hospital</p>
                                    <p><strong>Priority:</strong> Urgency level (Low, Medium, High)</p>
                                    <p><strong>Status:</strong> Current stage of the case</p>
                                    <div class="alert alert-info alert-sm" role="alert">
                                        Fields marked with <span class="text-danger">*</span> are required
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Deswa Management System &copy; 2026</strong> - Built for Efficiency
            <div class="float-end d-none d-sm-inline">
                <b>Version</b> 1.0
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
    <script>
        (() => {
            const category = document.getElementById('case_type');
            const claimKind = document.getElementById('claim_kind');
            const policyClaimType = document.getElementById('jenis_claim');
            const hospitalFields = document.getElementById('hospitalFields');
            const nonHospitalFields = document.getElementById('nonHospitalFields');
            const totalOutput = document.getElementById('hospitalTotal');
            const hospitalCosts = [...document.querySelectorAll('.hospital-cost')];
            const nonHospitalAmounts = [...nonHospitalFields.querySelectorAll('input')];
            const formatRupiah = (amount) => new Intl.NumberFormat('id-ID').format(amount);

            // --- Currency input masking (tampilan ada separator ribuan, value yang dikirim tetap angka polos) ---
            const parseCurrencyInput = (value) => {
                const digitsOnly = String(value || '').replace(/\D/g, '');
                return digitsOnly ? parseInt(digitsOnly, 10) : 0;
            };
            const formatCurrencyInputValue = (input) => {
                const raw = parseCurrencyInput(input.value);
                input.value = raw ? formatRupiah(raw) : '';
            };
            const currencyInputs = [...document.querySelectorAll('.currency-input')];
            currencyInputs.forEach((input) => {
                // Format ulang value awal (hasil render EJS) agar konsisten saat halaman dimuat
                formatCurrencyInputValue(input);
                input.addEventListener('input', () => formatCurrencyInputValue(input));
            });
            // Sebelum form dikirim, kembalikan semua currency-input ke angka polos tanpa separator
            document.querySelector('form').addEventListener('submit', () => {
                currencyInputs.forEach((input) => {
                    input.value = String(parseCurrencyInput(input.value));
                });
            });

            const hospitalType = 'Klaim Hospital';
            const nonHospitalType = 'Klaim Non Hospital';
            const claimKindCaseType = {
                'Klaim rawat inap': hospitalType,
                'Klaim perawatan 1 hari': hospitalType,
                'Klaim Meninggal Dunia': nonHospitalType,
                'Klaim Penyakit Kritis': nonHospitalType,
                'Credit Life': nonHospitalType
            };

            // --- Auto-calculate Usia Polis dari Tanggal Issued Polis s.d. Tanggal Meninggal/Tanggal Klaim ---
            const policyIssuedDateInput = document.getElementById('tanggal_issued_polis');
            const deathDateInput = document.getElementById('tanggal_meninggal');
            const causeOfDeathInput = document.getElementById('penyebab_meninggal');
            const claimEventDateInput = document.getElementById('incident_date'); // "Tanggal Kejadian Klaim" di section Data Klaim dan Penerima Manfaat
            const policyAgeInput = document.getElementById('usia_polis');

            const calculatePolicyAge = (startDateStr, endDateStr) => {
                const start = new Date(startDateStr);
                const end = new Date(endDateStr);
                if (isNaN(start.getTime()) || isNaN(end.getTime()) || end < start) return '';

                let years = end.getFullYear() - start.getFullYear();
                let months = end.getMonth() - start.getMonth();
                let days = end.getDate() - start.getDate();

                if (days < 0) {
                    months -= 1;
                    const prevMonthLastDay = new Date(end.getFullYear(), end.getMonth(), 0).getDate();
                    days += prevMonthLastDay;
                }
                if (months < 0) {
                    years -= 1;
                    months += 12;
                }

                // Pengaman untuk kasus langka (mis. tanggal 29-31 melewati bulan Februari)
                // agar hasil akhir tidak pernah negatif.
                if (days < 0) { days = 0; }
                if (months < 0) { months = 0; }
                if (years < 0) { years = 0; }

                return `${years} tahun ${months} bulan ${days} hari`;
            };

            const updatePolicyAge = () => {
                const isHospital = category.value === hospitalType;
                // Klaim Hospital: Usia Polis = Tanggal Issued Polis s.d. Tanggal Kejadian Klaim
                // Klaim Non Hospital: Usia Polis = Tanggal Issued Polis s.d. Tanggal Meninggal
                const endDateInput = isHospital ? claimEventDateInput : deathDateInput;
                if (!policyIssuedDateInput.value || !endDateInput.value) return;
                const result = calculatePolicyAge(policyIssuedDateInput.value, endDateInput.value);
                if (result) policyAgeInput.value = result;
            };

            policyIssuedDateInput.addEventListener('change', updatePolicyAge);
            deathDateInput.addEventListener('change', updatePolicyAge);
            claimEventDateInput.addEventListener('change', updatePolicyAge);
            updatePolicyAge(); // hitung otomatis saat halaman dimuat (mode edit, jika tanggal terkait sudah terisi)

            const updateClaimFields = () => {
                const isHospital = category.value === hospitalType;
                const isNonHospital = category.value === nonHospitalType;
                hospitalFields.hidden = !isHospital;
                nonHospitalFields.hidden = !isNonHospital;
                hospitalCosts.forEach((input) => {
                    input.disabled = !isHospital;
                    input.required = isHospital;
                });
                nonHospitalAmounts.forEach((input) => {
                    input.disabled = !isNonHospital;
                });
                policyClaimType.value = category.value;

                // Klaim Hospital: Tanggal & Penyebab Meninggal tidak relevan -> dibuat readonly
                deathDateInput.readOnly = isHospital;
                causeOfDeathInput.readOnly = isHospital;

                updatePolicyAge();
            };
            const updateHospitalTotal = () => {
                const complete = hospitalCosts.every((input) => input.value !== '');
                const total = hospitalCosts.reduce((sum, input) => sum + parseCurrencyInput(input.value), 0);
                const display = complete ? formatRupiah(total) : 'Isi seluruh rincian biaya';
                totalOutput.value = display;
                totalOutput.textContent = display;
            };

            category.addEventListener('change', () => {
                if (claimKindCaseType[claimKind.value] && claimKindCaseType[claimKind.value] !== category.value) {
                    claimKind.value = '';
                }
                updateClaimFields();
            });
            claimKind.addEventListener('change', () => {
                if (claimKindCaseType[claimKind.value]) category.value = claimKindCaseType[claimKind.value];
                updateClaimFields();
            });
            hospitalCosts.forEach((input) => {
                input.addEventListener('input', updateHospitalTotal);
            });
            updateClaimFields();
            updateHospitalTotal();
        })();
    </script>
</body>
</html>
